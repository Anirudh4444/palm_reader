# Expo Go Environment Variables
# Copy this file to .env and fill in your values

# Your deployed API domain (NO https:// prefix, NO trailing slash, NO /api suffix)
# The app constructs the full URL as: https://{EXPO_PUBLIC_DOMAIN}/api
# Examples:
#   EXPO_PUBLIC_DOMAIN=palm-api.railway.app
#   EXPO_PUBLIC_DOMAIN=abc123.ngrok.io
EXPO_PUBLIC_DOMAIN=your-api-domain.railway.app

# Full base URL for the readings API (WITH https:// prefix)
EXPO_PUBLIC_API_URL=https://your-api-domain.railway.app/api
